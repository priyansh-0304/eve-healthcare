# Copy this file to .env and adjust as needed for local (non-Docker) runs.

DATABASE_URL=postgresql://eve_user:eve_password@localhost:5432/eve_diagnostics
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Probability (0-1) a simulated payment succeeds.
PAYMENT_SUCCESS_RATE=0.8

# Shared secret the simulated payment provider must send in the
# X-Webhook-Secret header when calling POST /payments/webhook/.
WEBHOOK_SECRET=change-me-to-a-webhook-secret

# Optional. If unreachable, caching is silently disabled (see app/cache.py) —
# the app works fine without Redis, this just speeds up repeated list calls.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30
